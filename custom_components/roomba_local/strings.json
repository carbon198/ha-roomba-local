{
  "title": "Roomba Local",
  "config": {
    "step": {
      "user": {
        "title": "Connect to your local Roomba emulator",
        "description": "Connect one robot per integration entry. Telemetry, maps and supported controls come from your local emulator. Enter the token value without the Bearer prefix.",
        "data": {
          "api_url": "HTTPS server URL",
          "bearer_token": "Bearer token"
        }
      },
      "robot": {
        "title": "Choose robot",
        "description": "Choose a Roomba to add to Home Assistant. Only robots not already added from this emulator are shown. Options include the last six ID characters, model/SKU and IP address when available.",
        "data": {
          "robot_id": "Choose robot"
        }
      },
      "reauth_confirm": {
        "title": "Replace local bearer token",
        "description": "The token for {server} was rejected. Enter its replacement.",
        "data": {
          "bearer_token": "Bearer token"
        }
      },
      "reconfigure": {
        "title": "Update local server and token",
        "description": "Update the HTTPS origin or token for {server}. The robot and existing entity identities will be preserved.",
        "data": {
          "bearer_token": "Bearer token",
          "api_url": "HTTPS server URL"
        }
      }
    },
    "error": {
      "invalid_input": "Enter an HTTPS origin, a 32-character hexadecimal robot ID, and a valid token value without the Bearer prefix.",
